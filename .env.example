# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real credentials.

# --- Supabase (required) -----------------------------------------------------
# Supabase Dashboard → Project Settings → API → Project URL.
# The URL is not a secret; the NEXT_PUBLIC_ prefix is just Supabase's convention.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Dashboard → Project Settings → API Keys → Publishable key (sb_publishable_...).
# Safe to expose. The app does not read it today: every database call happens
# on the server with the secret key. It is listed so a browser client can be
# added later without another env change.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Dashboard → Project Settings → API Keys → Secret key (sb_secret_...).
# SECRET. Bypasses row level security. Only ever read on the server (lib/db.ts).
# Replaces the older SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# --- AI (optional) -----------------------------------------------------------
# Leave empty to run on the built-in deterministic fallback (templates + rules).
# Add a key from https://console.anthropic.com to switch on live AI generation.
# SECRET. Only ever read on the server (lib/ai.ts).
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- Admin (required for /admin) ---------------------------------------------
# Password for the admin dashboard. Pick a long random string.
# SECRET. Only ever read on the server (lib/auth.ts).
ADMIN_PASSWORD=
